{
  "name": "asotracmet",
  "version": "0.1.0",
  "private": true,
  "description": "ASOTRACMET — Sistema de enturnamiento y operación gremial (cola, ofertas, TR, viajes, recaudo, HSEQ)",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build && pnpm build:scripts",
    "build:scripts": "esbuild scripts/migrate-db.ts scripts/seed-db.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist/scripts --out-extension:.js=.mjs --external:pg --external:uuid --external:zod",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:db": "vitest run --project db",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:reset": "tsx scripts/migrate-db.ts && tsx scripts/seed-db.ts",
    "db:anonymize-staging": "tsx scripts/anonymize-staging.ts",
    "prepare": "husky",
    "db:migrate-xlsx": "tsx scripts/migrate-xlsx.ts"
  },
  "devDependencies": {
    "@asotracmet/api": "workspace:*",
    "@asotracmet/domain": "workspace:*",
    "@asotracmet/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,yaml,yml,css,html}": [
      "prettier --write"
    ]
  }
}
